# Скопируйте в .env для ручного запуска или /home/agent/.agent.env на сервере.
# Настоящие значения не должны попадать в Git.
TINVEST_TOKEN=
TINVEST_ACCOUNT_ID=

# Шлюз модели: тот же endpoint, что в конфигурации Codex.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# Необязательно: отображение квот провайдера.
OMNIROUTE_MGMT_KEY=

# Telegram необязателен. CHAT_ID — ID разрешённого оператора.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ключ панели: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
WEBAPP_KEY=
WEBAPP_BIND=127.0.0.1
WEBAPP_PORT=8080

# AGENT_DB, AGENT_DATA_DIR, AGENT_WORKDIR и RESEARCH_DB задавайте
# переменными окружения или в systemd: они не читаются из этого файла.
