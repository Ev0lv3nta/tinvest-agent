[Unit]
Description=SSH-туннель до OmniRoute
After=network-online.target
Wants=network-online.target
Before=tinvest-agent.service
ConditionPathExists=/etc/tinvest-agent/tunnel.env

[Service]
Type=simple
# Необязательный туннель; параметры задаются вне репозитория.
EnvironmentFile=/etc/tinvest-agent/tunnel.env
ExecStart=/usr/bin/ssh -i ${TUNNEL_IDENTITY} \
    -o BatchMode=yes -o StrictHostKeyChecking=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
    -N -L ${TUNNEL_FORWARD} ${TUNNEL_DESTINATION}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
