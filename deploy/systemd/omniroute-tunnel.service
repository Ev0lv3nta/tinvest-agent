[Unit]
Description=SSH-туннель до OmniRoute
After=network-online.target
Wants=network-online.target
Before=tinvest-agent.service

[Service]
Type=simple
# Прямой канал вместо Cloudflare Quick Tunnel: тот падал по семь раз в
# сутки на таймаутах к edge и менял адрес при перезапуске.
ExecStart=/usr/bin/ssh -i /root/.ssh/id_ed25519_omni \
    -o StrictHostKeyChecking=accept-new \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
    -N -L 127.0.0.1:20128:172.31.0.3:20128 root@45.148.125.31
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
