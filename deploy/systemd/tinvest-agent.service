[Unit]
Description=Супервизор торгового агента
After=network-online.target omniroute-tunnel.service
Wants=network-online.target
# Туннель поднимается первым, но не удерживает нас: Requires означал бы,
# что падение канала к модели останавливает и супервизор — вместе со
# сторожем позиций. Управление уже набранным риском не должно зависеть от
# того, доступна ли модель.
Wants=omniroute-tunnel.service

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/tinvest-agent
Environment=PYTHONPATH=/opt/tinvest-agent
Environment=PYTHONUNBUFFERED=1
Environment=AGENT_DB=/home/agent/state/agent.db
Environment=AGENT_WORKDIR=/home/agent/work
Environment=AGENT_DATA_DIR=/home/agent/data
# Реестр попыток лежит отдельно от торгового журнала: исследованию незачем
# открывать файл, в котором заявки.
Environment=RESEARCH_DB=/home/agent/state/research.db
Environment=HOME=/home/agent
ExecStart=/usr/bin/python3 -m supervisor.main
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
