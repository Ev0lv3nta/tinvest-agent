[Unit]
Description=Супервизор торгового агента
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/tinvest-agent
Environment=PYTHONPATH=/opt/tinvest-agent
Environment=PYTHONUNBUFFERED=1
Environment=AGENT_DB=/home/agent/state/agent.db
Environment=AGENT_WORKDIR=/home/agent/work
Environment=HOME=/home/agent
ExecStart=/usr/bin/python3 -m supervisor.main
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
